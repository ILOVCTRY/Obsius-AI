# 密钥与环境
.env
*.local.json
config/providers.json
config/fofa.json
config/tools.json
# 本机环境配置：MCP server 路径每机不同、Claude 工具钩子引用本机绝对路径（2026-09-29 提交治理）
config/mcp.json
# 本机反编译覆盖层：headless_timeout（秒）逐机不同（大样本加速 P1，2026-09-30）
config/decompiler.json
# 会话级常驻容器覆盖层：session_scoped/idle_timeout/reaper_interval 逐机不同（2026-10-07）
config/containers.json
.claude/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
# 桌面打包（desktop-app-shell M3）：打包 venv / PyInstaller 工作目录与产物
.build-venv/
build/
dist/
*.egg-info/
# 反编译临时目录缺省名（调用方应显式指入项目 workspace，防逃逸，§7）
.ghidra-tmp/

# 运行时数据
workspaces/
config/intel/
# 全局运行时数据归口（campaign.db 等，workspace-hygiene D1）
# 锚定项目根：勿写成 data/——会误伤随包资源目录 packs/data/、tools/data/
/data/
# 服务日志归口（workspace-hygiene D2；*.log 已全局覆盖，此处防非日志文件）
logs/
# Agent 产物总库（per-project 在 workspaces/ 下；项目根历史遗物见 .trash，D3）
artifacts/
# packs 编辑备份与回收站（.history/trash），API 写入自动生成
packs/**/.history/
*.db
*.db-wal
*.db-shm

# 工具按需安装目录（DESIGN.md §7 tools/installed/）
tools/installed/
# 工具二进制/运行时规范位（toolchain-registry：本体不进 git，桌面打包经 build_exe.py 随包旁挂）
# tools/bin/gmhttp.exe 由 scripts/build_gmhttp.py 构建（2026-10-07 国密 sidecar）
tools/bin/
tools/runtime/
tools/venv/

# 临时产物
*.tmp
*.log

# 工具与编辑器产物 / 运行时治理状态（不入库，2026-09-21）
.claudian/
.obsidian/
Cyber-pro/
mcp-servers/.playwright-mcp/
packs/.proposals/
webui/webui/
.history/
# 外部素材库（收编源材料，第三方许可，绝不整库入库）
开源优秀项目/
